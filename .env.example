# Admin account for the CMS
ADMIN_USERNAME=adam.liou
ADMIN_PASSWORD=your-strong-password-here
ADMIN_DISPLAY_NAME=Adam Liu
ADMIN_SESSION_SECRET=your-session-secret-here

# Optional WebAuthn RP ID override
# WEBAUTHN_RP_ID=localhost

# GitHub Personal Access Token (repo scope required)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository details (optional, defaults shown)
GITHUB_REPO_OWNER=LIUYUTSO
GITHUB_REPO_NAME=A-Stuff

# Cloudflare R2 (model/thumbnail storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=a-stuff
# Public base URL for the R2 custom domain (must be a domain connected to the
# bucket under R2 > Settings > Custom Domains — NOT the r2.cloudflarestorage.com
# S3 API endpoint, which is private and requires signed requests).
R2_PUBLIC_BASE_URL=https://cdn.adamliu.uk
